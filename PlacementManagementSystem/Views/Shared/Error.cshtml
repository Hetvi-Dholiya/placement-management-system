@model ErrorViewModel
@{
    ViewData["Title"] = "Application Notice";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card card-custom p-5 shadow-sm border-0">
                <div class="text-warning mb-3">
                    <i class="bi bi-exclamation-octagon-fill display-3"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Request Could Not Be Processed</h3>
                <p class="text-muted small mb-4">
                    An error occurred while processing your request. Please return to the previous page or go to your dashboard.
                </p>

                @if (Model?.ShowRequestId == true)
                {
                    <div class="bg-light p-2 rounded mb-3 small text-muted">
                        Reference ID: <code>@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-custom">
                        <i class="bi bi-house-door me-1"></i> Return Home
                    </a>
                    <a asp-controller="Student" asp-action="Dashboard" class="btn btn-primary-custom">
                        <i class="bi bi-speedometer2 me-1"></i> Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
