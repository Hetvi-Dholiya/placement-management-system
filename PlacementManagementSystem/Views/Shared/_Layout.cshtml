@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var isLoggedIn = session?.IsLoggedIn() ?? false;
    var isAdmin = session?.IsAdmin() ?? false;
    var isStudent = session?.IsStudent() ?? false;
    var userName = session?.GetCurrentUserName() ?? "Guest";
    var userRole = session?.GetCurrentUserRole() ?? "";
    var userPic = session?.GetString(PlacementManagementSystem.Helpers.SessionConstants.UserProfilePicture);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - College Placement Management System</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-cpms sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="navbar-brand-badge">CPMS</span>
                    <div class="d-none d-sm-block">
                        <span class="fw-bold fs-5 text-white">Placement Portal</span>
                        <small class="d-block text-secondary" style="font-size: 0.725rem; margin-top: -2px;">College Placement Management</small>
                    </div>
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>

                        @if (isLoggedIn && isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Student" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Student" asp-action="Index">
                                    <i class="bi bi-people me-1"></i> Students
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Company" asp-action="Index">
                                    <i class="bi bi-building me-1"></i> Companies
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PlacementDrive" asp-action="Index">
                                    <i class="bi bi-briefcase me-1"></i> Placement Drives
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Application" asp-action="Index">
                                    <i class="bi bi-file-earmark-text me-1"></i> Applications
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Placement" asp-action="Index">
                                    <i class="bi bi-award me-1"></i> Placements
                                </a>
                            </li>
                        }
                        else if (isLoggedIn && isStudent)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Student" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PlacementDrive" asp-action="Index">
                                    <i class="bi bi-briefcase me-1"></i> Placement Drives
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Application" asp-action="MyApplications">
                                    <i class="bi bi-send-check me-1"></i> My Applications
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Placement" asp-action="MyPlacement">
                                    <i class="bi bi-award me-1"></i> My Placement
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Company" asp-action="Index">
                                    <i class="bi bi-building me-1"></i> Companies
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Student" asp-action="Profile">
                                    <i class="bi bi-person-circle me-1"></i> Profile
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PlacementDrive" asp-action="Index">
                                    <i class="bi bi-briefcase me-1"></i> Placement Drives
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Company" asp-action="Index">
                                    <i class="bi bi-building me-1"></i> Companies
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Placement" asp-action="Index">
                                    <i class="bi bi-trophy me-1"></i> Placement Records
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="About">
                                    <i class="bi bi-info-circle me-1"></i> About
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (isLoggedIn)
                        {
                            <div class="dropdown">
                                <button class="btn btn-dark d-flex align-items-center gap-2 border border-secondary py-1 px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (!string.IsNullOrEmpty(userPic))
                                    {
                                        <img src="~/uploads/profiles/@userPic" alt="@userName" class="rounded-circle" style="width: 24px; height: 24px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle fs-5 text-primary-light"></i>
                                    }
                                    <span class="text-white fw-semibold small">@userName</span>
                                    <span class="badge @(isAdmin ? "bg-danger" : "bg-primary") ms-1">@userRole</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 py-2">
                                    <li class="dropdown-header text-uppercase small fw-bold">Signed in as</li>
                                    <li><span class="dropdown-item-text fw-bold text-dark">@userName</span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    @if (isStudent)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Student" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                        <li><a class="dropdown-item" asp-controller="Application" asp-action="MyApplications"><i class="bi bi-file-earmark-check me-2"></i>My Applications</a></li>
                                    }
                                    else if (isAdmin)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Student" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm px-3 fw-semibold" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                            <a class="btn btn-primary-custom btn-sm px-3" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i> Student Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        <div class="container pt-3">
            <partial name="_NotificationPartial" />
        </div>
        @RenderBody()
    </main>

    <footer class="footer-cpms">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="navbar-brand-badge py-1 px-2 fs-6">CPMS</span>
                        <h5 class="text-white mb-0 fw-bold">College Placement Cell</h5>
                    </div>
                    <p class="small text-secondary mb-3">
                        Empowering engineering graduates with premier career opportunities, campus drives, and end-to-end recruitment management.
                    </p>
                    <div class="d-flex gap-3 text-secondary fs-5">
                        <a href="#"><i class="bi bi-linkedin"></i></a>
                        <a href="#"><i class="bi bi-twitter-x"></i></a>
                        <a href="#"><i class="bi bi-envelope-fill"></i></a>
                        <a href="#"><i class="bi bi-telephone-fill"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white text-uppercase fw-bold mb-3 small tracking-wider">Quick Links</h6>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="PlacementDrive" asp-action="Index">Placement Drives</a></li>
                        <li><a asp-controller="Company" asp-action="Index">Partner Companies</a></li>
                        <li><a asp-controller="Placement" asp-action="Index">Placement Records</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white text-uppercase fw-bold mb-3 small tracking-wider">Academic Project</h6>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-2 text-secondary">
                        <li><span>Architecture: ASP.NET Core MVC</span></li>
                        <li><span>Database: Pomelo EF Core & MySQL</span></li>
                        <li><span>UI: Bootstrap 5 & Razor Views</span></li>
                        <li><span>Features: CRUD & State Management</span></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white text-uppercase fw-bold mb-3 small tracking-wider">Placement Office</h6>
                    <p class="small text-secondary mb-1"><i class="bi bi-geo-alt-fill me-1 text-primary-light"></i> Training & Placement Cell, Campus Block A</p>
                    <p class="small text-secondary mb-1"><i class="bi bi-envelope-at-fill me-1 text-primary-light"></i> admin@college.com</p>
                    <p class="small text-secondary"><i class="bi bi-telephone-inbound-fill me-1 text-primary-light"></i> +91 98765 43210</p>
                </div>
            </div>
            <hr class="border-secondary opacity-25 my-3" />
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center small text-secondary">
                <div>&copy; @DateTime.Now.Year - College Placement Management System. B.Tech CSE Mini-Project.</div>
                <div class="mt-2 mt-sm-0">
                    <span class="badge bg-dark border border-secondary text-light">Built with ASP.NET Core MVC & MySQL</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
