@{
    ViewData["Title"] = "About Us - College Placement Cell";
}

<div class="container py-4">
    <div class="row g-4 align-items-center mb-5">
        <div class="col-lg-7">
            <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-3 py-2 rounded-pill mb-2">
                <i class="bi bi-info-circle me-1"></i> About Central Placement Cell
            </span>
            <h1 class="display-6 fw-bold text-dark mb-3">
                Bridging Campus Brilliance with Industry Innovation
            </h1>
            <p class="lead text-muted mb-4">
                The College Training & Placement Cell (T&P) serves as the primary conduit between our engineering students and prestigious national & multinational enterprises.
            </p>
            <p class="text-secondary">
                Designed and built for the B.Tech Computer Science & Engineering department, the <strong>Placement Management System (CPMS)</strong> automates end-to-end recruitment drives, eligibility verification, student application tracking, and official placement statistics.
            </p>
        </div>
        <div class="col-lg-5">
            <div class="card card-custom p-4 bg-primary text-white shadow-lg">
                <h5 class="fw-bold mb-3"><i class="bi bi-shield-check me-2"></i>Academic Project Highlights</h5>
                <ul class="list-unstyled mb-0 d-flex flex-column gap-3 small">
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-check2-circle fs-5 text-warning"></i>
                        <div><strong>MVC Architecture:</strong> Strict separation of Model, View, and Controller layers using ASP.NET Core MVC.</div>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-check2-circle fs-5 text-warning"></i>
                        <div><strong>MySQL + EF Core:</strong> Pomelo MySQL database provider with Code-First migrations and LINQ queries.</div>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-check2-circle fs-5 text-warning"></i>
                        <div><strong>State Management:</strong> ASP.NET Core Session for role-based sessions and TempData for feedback alerts.</div>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-check2-circle fs-5 text-warning"></i>
                        <div><strong>Complete CRUD:</strong> Fully functioning CRUD across Students, Companies, Placement Drives, and Placements.</div>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- OBJECTIVES -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card card-custom p-4 h-100">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary mb-3">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <h5 class="fw-bold">Student Empowerment</h5>
                <p class="small text-muted mb-0">
                    Transparent visibility of job descriptions, required skillsets, salary CTC packages, and automated real-time eligibility checks before applying.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-custom p-4 h-100">
                <div class="stat-icon bg-success bg-opacity-10 text-success mb-3">
                    <i class="bi bi-building-check"></i>
                </div>
                <h5 class="fw-bold">Company Coordination</h5>
                <p class="small text-muted mb-0">
                    Comprehensive partner directory with HR contact profiles, campus drive scheduling, and seamless candidate shortlisting pipelines.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-custom p-4 h-100">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning mb-3">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <h5 class="fw-bold">Audit & Records</h5>
                <p class="small text-muted mb-0">
                    Accurate placement record maintenance, average and highest salary metrics, and branch-wise analytical insights for college accreditation.
                </p>
            </div>
        </div>
    </div>
</div>
