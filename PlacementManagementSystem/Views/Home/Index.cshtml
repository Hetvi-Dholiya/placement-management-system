@model IEnumerable<PlacementManagementSystem.Models.PlacementDrive>
@{
    ViewData["Title"] = "College Placement Portal";
    var recentPlacements = ViewBag.RecentPlacements as List<PlacementManagementSystem.Models.Placement> ?? new List<PlacementManagementSystem.Models.Placement>();
}

<!-- HERO SECTION -->
<section class="hero-section mb-5">
    <div class="container position-relative" style="z-index: 1;">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <span class="badge bg-light text-primary fw-bold px-3 py-2 rounded-pill mb-3 shadow-sm">
                    <i class="bi bi-mortarboard-fill me-1"></i> Campus Recruitment Season @DateTime.Now.Year
                </span>
                <h1 class="hero-title mb-3">
                    Accelerate Your Career with Top Global Recruiters
                </h1>
                <p class="hero-subtitle mb-4">
                    The official Central Placement Management System connecting aspiring students, academic departments, and premier technology organizations for seamless campus drives, shortlisting, and job placements.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="PlacementDrive" asp-action="Index" class="btn btn-primary-custom btn-lg shadow">
                        <i class="bi bi-search me-1"></i> Explore Placement Drives
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-person-plus me-1"></i> Student Registration
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-dark btn-lg border-secondary">
                        <i class="bi bi-shield-lock me-1"></i> Officer Login
                    </a>
                </div>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block">
                <div class="p-4 rounded-4 bg-white bg-opacity-10 backdrop-blur border border-white border-opacity-25 shadow-lg">
                    <div class="text-white-50 small text-uppercase fw-bold mb-1">Highest Package</div>
                    <div class="display-5 fw-extrabold text-warning">₹ @(ViewBag.HighestPackage != null ? $"{ViewBag.HighestPackage} LPA" : "22.5 LPA")</div>
                    <hr class="border-light opacity-25 my-3" />
                    <div class="text-white-50 small text-uppercase fw-bold mb-1">Placement Rate</div>
                    <div class="display-6 fw-bold text-success">88.5%</div>
                    <p class="small text-white-50 mb-0 mt-2">Across CSE, IT and ECE departments</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- LIVE STATS SECTION -->
<div class="container mb-5">
    <div class="row g-4">
        <div class="col-md-3 col-sm-6">
            <div class="stat-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Registered Students</div>
                        <div class="stat-number">@ViewBag.TotalStudents</div>
                    </div>
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Partner Companies</div>
                        <div class="stat-number">@ViewBag.TotalCompanies</div>
                    </div>
                    <div class="stat-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-building"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Placement Drives</div>
                        <div class="stat-number">@ViewBag.TotalDrives</div>
                    </div>
                    <div class="stat-icon bg-info bg-opacity-10 text-info">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Students Placed</div>
                        <div class="stat-number text-success">@ViewBag.StudentsPlaced</div>
                    </div>
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-trophy-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ACTIVE PLACEMENT DRIVES PREVIEW -->
<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="section-heading mb-1">Active Placement Drives</h2>
            <p class="text-muted small mb-0">Discover ongoing and upcoming campus recruitment opportunities</p>
        </div>
        <a asp-controller="PlacementDrive" asp-action="Index" class="btn btn-outline-custom btn-sm">
            View All Drives <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var drive in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card card-custom card-interactive h-100 p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-2 py-1 rounded">
                                    <i class="bi bi-geo-alt me-1"></i> @drive.JobLocation
                                </span>
                                <span class="status-badge status-badge-active">
                                    <i class="bi bi-check-circle-fill"></i> @drive.Status
                                </span>
                            </div>

                            <h5 class="fw-bold text-dark mb-1">@drive.JobTitle</h5>
                            <h6 class="text-primary fw-semibold mb-3">
                                <i class="bi bi-building me-1"></i> @drive.Company?.CompanyName
                            </h6>

                            <div class="bg-light p-3 rounded-3 mb-3">
                                <div class="row g-2 small">
                                    <div class="col-6">
                                        <span class="text-muted d-block">Package:</span>
                                        <strong class="text-success fs-6">₹ @drive.SalaryPackage.ToString("F2") LPA</strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted d-block">Min CGPA:</span>
                                        <strong>@drive.EligibilityCGPA.ToString("F2") / 10</strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted d-block">Department:</span>
                                        <strong class="text-truncate d-block">@drive.EligibleDepartment</strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted d-block">Vacancies:</span>
                                        <strong>@drive.NumberOfVacancies Positions</strong>
                                    </div>
                                </div>
                            </div>

                            <p class="small text-muted mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @drive.JobDescription
                            </p>
                        </div>

                        <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                            <span class="small text-danger fw-semibold">
                                <i class="bi bi-clock me-1"></i> Deadline: @drive.ApplicationDeadline.ToString("dd MMM yyyy")
                            </span>
                            <a asp-controller="PlacementDrive" asp-action="Details" asp-route-id="@drive.Id" class="btn btn-sm btn-primary-custom">
                                View & Apply <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <p class="text-muted mt-2">No active placement drives found right now. Check back soon!</p>
            </div>
        }
    </div>
</div>

<!-- HOW THE PLACEMENT PROCESS WORKS -->
<div class="container mb-5">
    <div class="card card-custom p-4 p-md-5 bg-light border-0 shadow-sm">
        <div class="text-center max-w-xl mx-auto mb-4">
            <span class="badge bg-primary text-white px-3 py-1 rounded-pill mb-2">Workflow</span>
            <h3 class="fw-bold text-dark">4-Step Campus Placement Workflow</h3>
            <p class="text-muted small">Standardized academic campus recruitment process for all undergraduate engineering batches</p>
        </div>
        <div class="row g-4 text-center">
            <div class="col-md-3 col-6">
                <div class="p-3 bg-white rounded-4 shadow-sm h-100">
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary mx-auto mb-3">1</div>
                    <h6 class="fw-bold mb-1">Register & Profile</h6>
                    <p class="small text-muted mb-0">Create student account with academic CGPA, department, and skills.</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3 bg-white rounded-4 shadow-sm h-100">
                    <div class="stat-icon bg-info bg-opacity-10 text-info mx-auto mb-3">2</div>
                    <h6 class="fw-bold mb-1">Check Eligibility</h6>
                    <p class="small text-muted mb-0">System automatically verifies CGPA, department criteria & deadline.</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3 bg-white rounded-4 shadow-sm h-100">
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning mx-auto mb-3">3</div>
                    <h6 class="fw-bold mb-1">Apply & Interview</h6>
                    <p class="small text-muted mb-0">Submit 1-click application and track Shortlisted & Interview status.</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3 bg-white rounded-4 shadow-sm h-100">
                    <div class="stat-icon bg-success bg-opacity-10 text-success mx-auto mb-3">4</div>
                    <h6 class="fw-bold mb-1">Get Placed</h6>
                    <p class="small text-muted mb-0">Receive final selection offer and official placement record entry.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- RECENT PLACEMENTS HALL OF FAME -->
@if (recentPlacements.Any())
{
    <div class="container mb-5">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="section-heading mb-1">Recent Placements</h2>
                <p class="text-muted small mb-0">Heartiest congratulations to our newly placed students</p>
            </div>
            <a asp-controller="Placement" asp-action="Index" class="btn btn-outline-custom btn-sm">
                View All Placements <i class="bi bi-trophy ms-1"></i>
            </a>
        </div>
        <div class="row g-4">
            @foreach (var p in recentPlacements)
            {
                <div class="col-md-3 col-sm-6">
                    <div class="card card-custom text-center p-4 h-100">
                        <div class="stat-icon bg-success bg-opacity-10 text-success mx-auto mb-3" style="width: 56px; height: 56px;">
                            <i class="bi bi-mortarboard-fill fs-3"></i>
                        </div>
                        <h6 class="fw-bold mb-1 text-dark">@p.Student?.FullName</h6>
                        <div class="small text-muted mb-2">@p.Student?.Department</div>
                        <span class="badge bg-primary bg-opacity-10 text-primary py-1 px-2 rounded mb-2">
                            <i class="bi bi-building"></i> @p.Company?.CompanyName
                        </span>
                        <div class="mt-2 text-success fw-bold fs-6">
                            ₹ @p.Package.ToString("F2") LPA
                        </div>
                        <small class="text-muted">@p.JobRole</small>
                    </div>
                </div>
            }
        </div>
    </div>
}
