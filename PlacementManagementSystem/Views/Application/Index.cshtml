@model IEnumerable<PlacementManagementSystem.Models.Application>
@{
    ViewData["Title"] = "Applications Management";
    var drives = ViewBag.Drives as SelectList;
    var searchString = ViewBag.SearchString as string;
    var selectedStatus = ViewBag.SelectedStatus as string;
    var selectedDriveId = ViewBag.SelectedDriveId as int?;
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-3 mb-4 border-bottom">
        <div>
            <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-3 py-1 rounded-pill mb-1">
                Admin Management
            </span>
            <h1 class="h2 fw-bold text-dark mb-0">Student Applications</h1>
            <p class="text-muted small mb-0 mt-1">Review student applications, manage recruitment screening stages, and update round results</p>
        </div>
        <div class="mt-3 mt-md-0">
            <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                Total Applications: <strong>@Model.Count()</strong>
            </span>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="filter-card">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small">Search Student or Drive</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@searchString" class="form-control border-start-0" placeholder="Student name, enrollment, company..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Filter by Drive</label>
                    <select name="driveId" class="form-select" asp-items="drives">
                        <option value="">All Placement Drives</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Filter by Status</label>
                    <select name="status" class="form-select">
                        <option value="All">All Statuses</option>
                        <option value="Applied" selected="@(selectedStatus == "Applied")">Applied</option>
                        <option value="Shortlisted" selected="@(selectedStatus == "Shortlisted")">Shortlisted</option>
                        <option value="Interview" selected="@(selectedStatus == "Interview")">Interview</option>
                        <option value="Selected" selected="@(selectedStatus == "Selected")">Selected</option>
                        <option value="Rejected" selected="@(selectedStatus == "Rejected")">Rejected</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary-custom flex-grow-1">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-custom">
                        Reset
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- APPLICATIONS TABLE -->
    <div class="table-custom shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>CGPA & Dept</th>
                        <th>Company & Role</th>
                        <th>Applied Date</th>
                        <th>Status</th>
                        <th>Remarks</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var app in Model)
                        {
                            var badgeClass = app.Status switch
                            {
                                "Selected" => "status-badge-selected",
                                "Interview" => "status-badge-interview",
                                "Shortlisted" => "status-badge-shortlisted",
                                "Rejected" => "status-badge-rejected",
                                _ => "status-badge-applied"
                            };

                            <tr>
                                <td>
                                    <strong class="d-block text-dark">@app.Student?.FullName</strong>
                                    <span class="small text-muted">@app.Student?.EnrollmentNo</span>
                                </td>
                                <td>
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold">@app.Student?.CGPA.ToString("F2") CGPA</span>
                                    <div class="small text-muted">@app.Student?.Department</div>
                                </td>
                                <td>
                                    <strong class="d-block text-dark">@app.PlacementDrive?.Company?.CompanyName</strong>
                                    <span class="small text-primary">@app.PlacementDrive?.JobTitle</span>
                                </td>
                                <td>@app.ApplicationDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="status-badge @badgeClass py-1 px-2" style="font-size: 0.8rem;">
                                        @app.Status
                                    </span>
                                </td>
                                <td>
                                    <span class="small text-muted" style="display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; max-width: 180px;">
                                        @(string.IsNullOrEmpty(app.Remarks) ? "-" : app.Remarks)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@app.Id" class="btn btn-outline-primary" title="Review & Update Status">
                                            <i class="bi bi-sliders me-1"></i> Review
                                        </a>
                                        @if (app.Status == "Selected")
                                        {
                                            <a asp-controller="Placement" asp-action="Create" asp-route-applicationId="@app.Id" class="btn btn-success" title="Generate Placement Offer">
                                                <i class="bi bi-award"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-file-earmark-x fs-2"></i>
                                <p class="mt-2 mb-0">No applications found matching the selected filters.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
