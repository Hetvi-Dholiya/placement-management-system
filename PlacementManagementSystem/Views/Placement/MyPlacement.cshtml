@model PlacementManagementSystem.Models.Placement
@{
    ViewData["Title"] = "My Placement Status";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-3 py-1 rounded-pill mb-1">
                Student Career
            </span>
            <h2 class="fw-bold text-dark mb-0">My Placement Status</h2>
            <p class="text-muted small mb-0 mt-1">Official campus recruitment outcome and job offer summary</p>
        </div>
        <a asp-controller="Student" asp-action="Dashboard" class="btn btn-outline-custom btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
    </div>

    @if (Model != null && Model.Status == "Placed")
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- OFFER CARD -->
                <div class="card card-custom shadow-lg border-0 overflow-hidden mb-4">
                    <div class="p-4 p-md-5 text-white text-center position-relative" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #059669 100%);">
                        <div class="stat-icon bg-white text-success rounded-circle mx-auto mb-3 shadow" style="width: 72px; height: 72px;">
                            <i class="bi bi-trophy-fill fs-2"></i>
                        </div>
                        <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill mb-2">CAMPUS RECRUITMENT OFFER</span>
                        <h2 class="fw-bold mb-1">Congratulations, @Model.Student?.FullName!</h2>
                        <p class="text-white-50 small mb-0">
                            We are delighted to confirm your campus placement with <strong>@Model.Company?.CompanyName</strong>.
                        </p>
                    </div>

                    <div class="card-body p-4 p-md-5 bg-white">
                        <div class="row g-4 mb-4">
                            <div class="col-sm-6">
                                <div class="p-3 rounded-3 bg-light border">
                                    <span class="text-muted small d-block mb-1">Offered Role</span>
                                    <h5 class="fw-bold text-dark mb-0">@Model.JobRole</h5>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 rounded-3 bg-light border">
                                    <span class="text-muted small d-block mb-1">Salary Package (CTC)</span>
                                    <h5 class="fw-bold text-success mb-0">₹ @Model.Package.ToString("F2") LPA</h5>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 rounded-3 bg-light border">
                                    <span class="text-muted small d-block mb-1">Hiring Organization</span>
                                    <h6 class="fw-bold text-dark mb-0">@Model.Company?.CompanyName</h6>
                                    <small class="text-muted">@Model.Company?.Location</small>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 rounded-3 bg-light border">
                                    <span class="text-muted small d-block mb-1">Placement Date</span>
                                    <h6 class="fw-bold text-dark mb-0">@Model.PlacementDate.ToString("dd MMMM yyyy")</h6>
                                    <span class="status-badge status-badge-placed py-0 px-2 mt-1" style="font-size: 0.75rem;">Verified Offer</span>
                                </div>
                            </div>
                        </div>

                        <div class="bg-light p-3 rounded-3 mb-4 small text-muted border">
                            <h6 class="fw-bold text-dark mb-1"><i class="bi bi-info-circle me-1 text-primary"></i>Next Steps & Verification</h6>
                            The college Training & Placement Cell has officially endorsed your candidate dossier to @Model.Company?.CompanyName. The formal joining formalities, documentation, and onboarding orientation schedules will be dispatched to your registered email address (<code>@Model.Student?.Email</code>).
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button onclick="window.print()" class="btn btn-outline-custom">
                                <i class="bi bi-printer me-1"></i> Print Confirmation
                            </button>
                            <a asp-controller="PlacementDrive" asp-action="Details" asp-route-id="@Model.PlacementDriveId" class="btn btn-primary-custom">
                                View Placement Drive
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6 text-center py-5">
                <div class="card card-custom p-5 shadow-sm border-0">
                    <div class="text-primary mb-3">
                        <i class="bi bi-hourglass-split display-2 text-warning"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-2">No Active Placement Yet</h3>
                    <p class="text-muted small mb-4">
                        You have not been marked as placed yet. Continue participating in active placement drives and tracking your application shortlists!
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="PlacementDrive" asp-action="Index" class="btn btn-primary-custom">
                            <i class="bi bi-briefcase me-1"></i> Browse Active Drives
                        </a>
                        <a asp-controller="Application" asp-action="MyApplications" class="btn btn-outline-custom">
                            <i class="bi bi-file-earmark-check me-1"></i> My Applications
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
