@model PlacementManagementSystem.Models.Placement
@{
    ViewData["Title"] = $"Delete Placement - {Model.Student?.FullName}";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card card-custom p-4 shadow-sm border-danger">
                <div class="text-center mb-3 text-danger">
                    <i class="bi bi-award display-4"></i>
                    <h3 class="fw-bold mt-2 text-dark">Confirm Placement Record Deletion</h3>
                    <p class="text-muted small">Are you sure you want to permanently remove this official placement record?</p>
                </div>

                <div class="bg-light p-3 rounded-3 mb-4 small">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Student:</span>
                        <strong class="text-dark">@Model.Student?.FullName (@Model.Student?.EnrollmentNo)</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Company:</span>
                        <strong class="text-dark">@Model.Company?.CompanyName</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Role:</span>
                        <strong class="text-dark">@Model.JobRole</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Package:</span>
                        <strong class="text-success fs-6">₹ @Model.Package.ToString("F2") LPA</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Date:</span>
                        <strong class="text-dark">@Model.PlacementDate.ToString("dd MMM yyyy")</strong>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-custom">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold">
                            <i class="bi bi-trash-fill me-1"></i> Yes, Delete Record
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
