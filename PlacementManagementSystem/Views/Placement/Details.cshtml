@model PlacementManagementSystem.Models.Placement
@{
    ViewData["Title"] = $"Placement Record - {Model.Student?.FullName}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-1 rounded-pill mb-1">
                Placement Record
            </span>
            <h2 class="fw-bold text-dark mb-0">@Model.Student?.FullName</h2>
            <div class="text-muted small">@Model.Student?.EnrollmentNo &bull; @Model.Student?.Department</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-custom btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit Record
            </a>
            <a asp-action="Index" class="btn btn-outline-custom btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Placements
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-custom p-4 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-start mb-3 pb-3 border-bottom">
                    <div>
                        <h4 class="fw-bold text-dark mb-1">@Model.JobRole</h4>
                        <div class="text-primary fw-semibold fs-5">
                            <i class="bi bi-building me-1"></i> @Model.Company?.CompanyName
                        </div>
                    </div>
                    <span class="status-badge status-badge-placed fs-6">
                        @Model.Status
                    </span>
                </div>

                <div class="d-flex flex-column gap-3 small mb-4">
                    <div class="d-flex justify-content-between pb-2 border-bottom">
                        <span class="text-muted">Salary CTC Package:</span>
                        <strong class="text-success fs-5">₹ @Model.Package.ToString("F2") LPA</strong>
                    </div>
                    <div class="d-flex justify-content-between pb-2 border-bottom">
                        <span class="text-muted">Candidate Student:</span>
                        <strong class="text-dark">@Model.Student?.FullName (@Model.Student?.EnrollmentNo)</strong>
                    </div>
                    <div class="d-flex justify-content-between pb-2 border-bottom">
                        <span class="text-muted">Department:</span>
                        <strong class="text-dark">@Model.Student?.Department</strong>
                    </div>
                    <div class="d-flex justify-content-between pb-2 border-bottom">
                        <span class="text-muted">Student CGPA:</span>
                        <span class="badge bg-success">@Model.Student?.CGPA.ToString("F2") / 10</span>
                    </div>
                    <div class="d-flex justify-content-between pb-2 border-bottom">
                        <span class="text-muted">Recruiting Organization:</span>
                        <strong class="text-dark">@Model.Company?.CompanyName (@Model.Company?.Location)</strong>
                    </div>
                    <div class="d-flex justify-content-between pb-2 border-bottom">
                        <span class="text-muted">Placement Drive:</span>
                        <strong class="text-dark">@Model.PlacementDrive?.JobTitle</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Date of Placement:</span>
                        <strong class="text-dark">@Model.PlacementDate.ToString("dd MMMM yyyy")</strong>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-trash me-1"></i> Delete Record
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
