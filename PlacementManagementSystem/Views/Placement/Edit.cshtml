@model PlacementManagementSystem.Models.Placement
@{
    ViewData["Title"] = $"Edit Placement - {Model.Student?.FullName}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card form-card shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Placement Record</h4>
                        <small class="text-muted">Modify placement compensation, job role, or offer status</small>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-custom btn-sm">Back to List</a>
                </div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="StudentId" class="form-label">Placed Student</label>
                            <select asp-for="StudentId" class="form-select" asp-items="ViewBag.StudentId">
                            </select>
                            <span asp-validation-for="StudentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyId" class="form-label">Hiring Company</label>
                            <select asp-for="CompanyId" class="form-select" asp-items="ViewBag.CompanyId">
                            </select>
                            <span asp-validation-for="CompanyId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PlacementDriveId" class="form-label">Placement Drive</label>
                            <select asp-for="PlacementDriveId" class="form-select" asp-items="ViewBag.PlacementDriveId">
                            </select>
                            <span asp-validation-for="PlacementDriveId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="JobRole" class="form-label"></label>
                            <input asp-for="JobRole" class="form-control" />
                            <span asp-validation-for="JobRole" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Package" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="Package" class="form-control" type="number" step="0.25" min="0.5" max="100" />
                                <span class="input-group-text">LPA</span>
                            </div>
                            <span asp-validation-for="Package" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PlacementDate" class="form-label"></label>
                            <input asp-for="PlacementDate" class="form-control" type="date" />
                            <span asp-validation-for="PlacementDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Placed">Placed (Offer Accepted)</option>
                                <option value="Pending">Pending (Awaiting Offer Letter)</option>
                                <option value="Cancelled">Cancelled (Offer Declined)</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-custom">Cancel</a>
                        <button type="submit" class="btn btn-primary-custom px-4 fw-bold">
                            <i class="bi bi-save me-1"></i> Update Placement
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
