@model PlacementManagementSystem.Models.Company
@{
    ViewData["Title"] = "Add New Company";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card form-card shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-building-add text-primary me-2"></i>Register Recruiting Company</h4>
                        <small class="text-muted">Add a partner organization to schedule campus placement drives</small>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-custom btn-sm">Back to List</a>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label asp-for="CompanyName" class="form-label"></label>
                            <input asp-for="CompanyName" class="form-control" placeholder="e.g. Google India, Infosys Limited" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="Industry" class="form-label"></label>
                            <input asp-for="Industry" class="form-control" placeholder="e.g. Software, Fintech, Consulting" />
                            <span asp-validation-for="Industry" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="CompanyDescription" class="form-label"></label>
                            <textarea asp-for="CompanyDescription" class="form-control" rows="3" placeholder="Brief summary of company, products, and engineering culture..."></textarea>
                            <span asp-validation-for="CompanyDescription" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" placeholder="City, State (e.g. Bengaluru, Karnataka)" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Website" class="form-label"></label>
                            <input asp-for="Website" class="form-control" placeholder="https://www.example.com" />
                            <span asp-validation-for="Website" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4">
                            <h6 class="fw-bold text-dark pb-2 border-bottom"><i class="bi bi-person-lines-fill me-2 text-primary"></i>HR Coordinator Details</h6>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="HRName" class="form-label"></label>
                            <input asp-for="HRName" class="form-control" placeholder="Contact person name" />
                            <span asp-validation-for="HRName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="HREmail" class="form-label"></label>
                            <input asp-for="HREmail" class="form-control" placeholder="hr@company.com" />
                            <span asp-validation-for="HREmail" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ContactNumber" class="form-label"></label>
                            <input asp-for="ContactNumber" class="form-control" placeholder="Contact mobile number" />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-custom">Cancel</a>
                        <button type="submit" class="btn btn-primary-custom px-4 fw-bold">
                            <i class="bi bi-check-lg me-1"></i> Save Company
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
