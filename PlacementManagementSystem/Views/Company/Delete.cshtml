@model PlacementManagementSystem.Models.Company
@{
    ViewData["Title"] = $"Delete Company - {Model.CompanyName}";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card card-custom p-4 shadow-sm border-danger">
                <div class="text-center mb-3 text-danger">
                    <i class="bi bi-building-dash display-4"></i>
                    <h3 class="fw-bold mt-2 text-dark">Confirm Company Deletion</h3>
                    <p class="text-muted small">Are you sure you want to delete this recruiting company record?</p>
                </div>

                <div class="bg-light p-3 rounded-3 mb-4 small">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Company Name:</span>
                        <strong class="text-dark">@Model.CompanyName</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Industry:</span>
                        <strong class="text-dark">@Model.Industry</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Location:</span>
                        <strong class="text-dark">@Model.Location</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Registered Placement Drives:</span>
                        <span class="badge bg-secondary">@Model.PlacementDrives.Count Drives</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Placed Candidates:</span>
                        <span class="badge bg-success">@Model.Placements.Count Placed</span>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-custom">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold">
                            <i class="bi bi-trash-fill me-1"></i> Yes, Delete Company
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
