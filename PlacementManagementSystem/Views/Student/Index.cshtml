@model IEnumerable<PlacementManagementSystem.Models.Student>
@{
    ViewData["Title"] = "Students Directory";
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    var selectedDept = ViewBag.SelectedDepartment as string;
    var searchString = ViewBag.SearchString as string;
    var minCgpa = ViewBag.MinCgpa as decimal?;
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-3 mb-4 border-bottom">
        <div>
            <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-3 py-1 rounded-pill mb-1">
                <i class="bi bi-people-fill me-1"></i> Admin Module
            </span>
            <h1 class="h2 fw-bold text-dark mb-0">Students Directory</h1>
            <p class="text-muted small mb-0 mt-1">Manage student profiles, verify academic credentials, and monitor placement statuses</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-primary-custom btn-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Add New Student
            </a>
        </div>
    </div>

    <!-- SEARCH & FILTER BAR -->
    <div class="filter-card">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small">Search Student</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@searchString" class="form-control border-start-0" placeholder="Name, Enrollment No, or Skill..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Filter by Department</label>
                    <select name="department" class="form-select">
                        <option value="All">All Departments</option>
                        @foreach (var d in departments)
                        {
                            <option value="@d" selected="@(selectedDept == d)">@d</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Min CGPA</label>
                    <input type="number" step="0.1" min="0" max="10" name="minCgpa" value="@minCgpa" class="form-control" placeholder="e.g. 7.5" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary-custom flex-grow-1">
                        <i class="bi bi-funnel me-1"></i> Apply Filters
                    </button>
                    <a asp-action="Index" class="btn btn-outline-custom">
                        Reset
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- STUDENTS TABLE -->
    <div class="table-custom shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Enrollment No</th>
                        <th>Student Name</th>
                        <th>Department</th>
                        <th>Sem</th>
                        <th>CGPA</th>
                        <th>Applications</th>
                        <th>Placement</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var student in Model)
                        {
                            var isPlaced = student.Placements.Any(p => p.Status == "Placed");
                            <tr>
                                <td><strong class="text-primary">@student.EnrollmentNo</strong></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(student.ProfilePicture))
                                        {
                                            <img src="~/uploads/profiles/@student.ProfilePicture" alt="@student.FullName" class="rounded-circle border" style="width: 34px; height: 34px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="stat-icon bg-primary bg-opacity-10 text-primary rounded-circle" style="width: 34px; height: 34px; font-size: 0.9rem;">
                                                <i class="bi bi-person"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold text-dark">@student.FullName</div>
                                            <div class="small text-muted">@student.Email &bull; @student.Phone</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="small">@student.Department</span></td>
                                <td>Semester @student.Semester</td>
                                <td>
                                    <span class="badge @(student.CGPA >= 8.0m ? "bg-success" : (student.CGPA >= 7.0m ? "bg-primary" : "bg-warning text-dark")) px-2 py-1">
                                        @student.CGPA.ToString("F2")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @student.Applications.Count Applied
                                    </span>
                                </td>
                                <td>
                                    @if (isPlaced)
                                    {
                                        <span class="status-badge status-badge-placed py-0 px-2" style="font-size: 0.75rem;">
                                            <i class="bi bi-check-all"></i> Placed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-badge-closed py-0 px-2" style="font-size: 0.75rem;">
                                            Unplaced
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-outline-primary" title="Edit Student">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-outline-danger" title="Delete Student">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-search fs-2"></i>
                                <p class="mt-2 mb-0">No student records found matching the specified filters.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
