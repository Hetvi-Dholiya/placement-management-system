@model PlacementManagementSystem.Models.Student
@{
    ViewData["Title"] = $"Edit Student - {Model.FullName}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card form-card shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Student Record</h4>
                        <small class="text-muted">Update academic credentials, contact info or reset student password</small>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-custom btn-sm">Back to List</a>
                </div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="EnrollmentNo" class="form-label"></label>
                            <input asp-for="EnrollmentNo" class="form-control" />
                            <span asp-validation-for="EnrollmentNo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label"></label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Gender" class="form-label"></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Semester" class="form-label"></label>
                            <select asp-for="Semester" class="form-select">
                                @for (int i = 1; i <= 8; i++)
                                {
                                    <option value="@i">Semester @i</option>
                                }
                            </select>
                            <span asp-validation-for="Semester" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Department" class="form-label"></label>
                            <select asp-for="Department" class="form-select">
                                <option value="Computer Science and Engineering">Computer Science and Engineering</option>
                                <option value="Information Technology">Information Technology</option>
                                <option value="Electronics and Communication">Electronics and Communication</option>
                                <option value="Mechanical Engineering">Mechanical Engineering</option>
                                <option value="Civil Engineering">Civil Engineering</option>
                            </select>
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CGPA" class="form-label"></label>
                            <input asp-for="CGPA" class="form-control" type="number" step="0.01" min="0" max="10" />
                            <span asp-validation-for="CGPA" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Skills" class="form-label"></label>
                            <input asp-for="Skills" class="form-control" />
                            <span asp-validation-for="Skills" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Reset Password (optional)</label>
                            <input type="password" name="newPassword" class="form-control" placeholder="Leave empty to keep existing password" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-custom">Cancel</a>
                        <button type="submit" class="btn btn-primary-custom px-4 fw-bold">
                            <i class="bi bi-save me-1"></i> Update Record
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
