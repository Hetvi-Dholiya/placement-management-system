@model PlacementManagementSystem.Models.PlacementDrive
@{
    ViewData["Title"] = $"Delete Drive - {Model.JobTitle}";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card card-custom p-4 shadow-sm border-danger">
                <div class="text-center mb-3 text-danger">
                    <i class="bi bi-briefcase display-4"></i>
                    <h3 class="fw-bold mt-2 text-dark">Confirm Drive Deletion</h3>
                    <p class="text-muted small">Are you sure you want to delete this placement drive? Associated student applications will also be removed.</p>
                </div>

                <div class="bg-light p-3 rounded-3 mb-4 small">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Job Role:</span>
                        <strong class="text-dark">@Model.JobTitle</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Company:</span>
                        <strong class="text-dark">@Model.Company?.CompanyName</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Package:</span>
                        <strong class="text-success">₹ @Model.SalaryPackage.ToString("F2") LPA</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Drive Date:</span>
                        <strong class="text-dark">@Model.DriveDate.ToString("dd MMM yyyy")</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Applications Received:</span>
                        <span class="badge bg-secondary">@Model.Applications.Count</span>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-custom">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold">
                            <i class="bi bi-trash-fill me-1"></i> Yes, Delete Drive
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
