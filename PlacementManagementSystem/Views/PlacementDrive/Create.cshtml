@model PlacementManagementSystem.Models.PlacementDrive
@{
    ViewData["Title"] = "Create Placement Drive";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card form-card shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-briefcase-fill text-primary me-2"></i>Create New Placement Drive</h4>
                        <small class="text-muted">Schedule a campus recruitment drive with eligibility criteria and package details</small>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-custom btn-sm">Back to List</a>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CompanyId" class="form-label">Recruiting Company</label>
                            <select asp-for="CompanyId" class="form-select" asp-items="ViewBag.CompanyId">
                                <option value="">-- Select Company --</option>
                            </select>
                            <span asp-validation-for="CompanyId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="JobTitle" class="form-label"></label>
                            <input asp-for="JobTitle" class="form-control" placeholder="e.g. Software Engineer, Cloud Trainee" />
                            <span asp-validation-for="JobTitle" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="JobDescription" class="form-label"></label>
                            <textarea asp-for="JobDescription" class="form-control" rows="3" placeholder="Job responsibilities, team overview, and day-to-day requirements..."></textarea>
                            <span asp-validation-for="JobDescription" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="SalaryPackage" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="SalaryPackage" class="form-control" type="number" step="0.25" min="0.5" max="100" placeholder="e.g. 8.50" />
                                <span class="input-group-text">LPA</span>
                            </div>
                            <span asp-validation-for="SalaryPackage" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="EligibilityCGPA" class="form-label"></label>
                            <input asp-for="EligibilityCGPA" class="form-control" type="number" step="0.1" min="0" max="10" placeholder="e.g. 7.00" />
                            <span asp-validation-for="EligibilityCGPA" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="NumberOfVacancies" class="form-label"></label>
                            <input asp-for="NumberOfVacancies" class="form-control" type="number" min="1" max="1000" />
                            <span asp-validation-for="NumberOfVacancies" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EligibleDepartment" class="form-label"></label>
                            <select asp-for="EligibleDepartment" class="form-select">
                                <option value="All">All Departments (Open to All)</option>
                                <option value="Computer Science and Engineering">Computer Science and Engineering</option>
                                <option value="Information Technology">Information Technology</option>
                                <option value="Electronics and Communication">Electronics and Communication</option>
                                <option value="Mechanical Engineering">Mechanical Engineering</option>
                                <option value="Civil Engineering">Civil Engineering</option>
                            </select>
                            <span asp-validation-for="EligibleDepartment" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="JobLocation" class="form-label"></label>
                            <input asp-for="JobLocation" class="form-control" placeholder="e.g. Bengaluru, Hyderabad, Pan India" />
                            <span asp-validation-for="JobLocation" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="RequiredSkills" class="form-label"></label>
                            <input asp-for="RequiredSkills" class="form-control" placeholder="e.g. Java, Data Structures, Python, SQL, REST APIs" />
                            <span asp-validation-for="RequiredSkills" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="DriveDate" class="form-label"></label>
                            <input asp-for="DriveDate" class="form-control" type="date" />
                            <span asp-validation-for="DriveDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ApplicationDeadline" class="form-label"></label>
                            <input asp-for="ApplicationDeadline" class="form-control" type="date" />
                            <span asp-validation-for="ApplicationDeadline" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Upcoming">Upcoming</option>
                                <option value="Closed">Closed</option>
                                <option value="Completed">Completed</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-custom">Cancel</a>
                        <button type="submit" class="btn btn-primary-custom px-4 fw-bold">
                            <i class="bi bi-calendar-check me-1"></i> Publish Drive
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
